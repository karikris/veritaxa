# Copy these server-only settings into Streamlit Community Cloud's Secrets editor.
# The snapshot must remain private and must never be added to Git.
MAP_SNAPSHOT_URL = "https://example.invalid/private-snapshot"
# For a local-only preview, use MAP_SNAPSHOT_PATH instead of MAP_SNAPSHOT_URL.
# MAP_SNAPSHOT_PATH = "/absolute/path/to/private-map-snapshot.json"
