{
  "name": "veritaxa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal authenticated image triage for taxonomic training data",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
